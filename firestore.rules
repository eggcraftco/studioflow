rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function companyPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId);
    }

    function isOwnWorkspace(companyId) {
      return signedIn() && companyId == request.auth.uid;
    }

    function companyExists(companyId) {
      return exists(companyPath(companyId));
    }

    function memberRole(companyId) {
      return get(companyPath(companyId)).data.members[request.auth.uid].role;
    }

    // A member whose seat a smaller plan took away. Their record stays whole —
    // the name on old orders, the history they wrote, their assignments — but
    // they are out of the workspace until the owner puts them back. Read-only
    // was rejected deliberately: somebody who has left should not go on reading
    // customer records, invoices and files.
    //
    // Kept in its own top-level map rather than as a flag inside `members`,
    // because `members` is a field an owner on a Team plan may write from a
    // client, and rules cannot protect one sub-key of it. suspendedMembers is
    // in protectedBillingFields(): no client writes it, ever. Read with a
    // default, because a workspace that has never suspended anybody has no such
    // field and an undefined here would lock everybody out instead of one
    // person in.
    function memberSuspended(companyId) {
      return request.auth.uid in get(companyPath(companyId)).data.get('suspendedMembers', {});
    }

    function isCompanyOwner(companyId) {
      return isOwnWorkspace(companyId)
        || (
          signedIn()
          && companyExists(companyId)
          && get(companyPath(companyId)).data.ownerUid == request.auth.uid
        );
    }

    function canReadCompany(companyId) {
      return isCompanyOwner(companyId)
        || (
          signedIn()
          && companyExists(companyId)
          && memberRole(companyId) in ['owner', 'admin', 'member', 'viewer', 'workflow', 'workflowOnly', 'workflow_only', 'workflow-only', 'Workflow Only']
          && !memberSuspended(companyId)
        );
    }

    function canWriteCompanyData(companyId) {
      return isCompanyOwner(companyId)
        || (
          signedIn()
          && companyExists(companyId)
          && memberRole(companyId) in ['owner', 'admin', 'member']
          && !memberSuspended(companyId)
        );
    }

    function isWorkflowOnlyMember(companyId) {
      return signedIn()
        && !isCompanyOwner(companyId)
        && companyExists(companyId)
        && memberRole(companyId) in ['workflow', 'workflowOnly', 'workflow_only', 'workflow-only', 'Workflow Only']
        && !memberSuspended(companyId);
    }

    // Custom role with "Assigned Projects Only" toggled ON and "Change Project Assignments"
    // toggled OFF — base role is still `member`, but the user is restricted to their own
    // assigned orders. They can create/read/update/delete their OWN orders directly
    // (full member-tier access including financial fields), but cannot reassign them
    // to someone else and cannot see other people's orders.
    // Read with .get() defaults: a memberAccess entry written before a key
    // existed (or a member with no entry at all) must evaluate to "not
    // restricted", not error the whole rule. A missing assignedProjectsOnly
    // used to throw "Property assignedProjectsOnly is undefined" and lock the
    // member out of every list query.
    function memberAccessEntry(companyId) {
      return get(companyPath(companyId)).data.get('memberAccess', {}).get(request.auth.uid, {});
    }

    function isAssignedOnlyCustomMember(companyId) {
      return signedIn()
        && !isCompanyOwner(companyId)
        && companyExists(companyId)
        && !isWorkflowOnlyMember(companyId)
        && memberAccessEntry(companyId).get('assignedProjectsOnly', false) == true
        && memberAccessEntry(companyId).get('manageProjectAssignments', false) != true;
    }

    // Per-member access flag granted by the owner in Team Access. The server
    // always mirrors the effective access into memberAccess[uid] (custom-role
    // fan-out included), so one lookup is enough here.
    function memberAccessAllows(companyId, key) {
      return signedIn()
        && companyExists(companyId)
        && memberAccessEntry(companyId).get(key, false) == true;
    }

    // Bank Spending feed: owner, or a member the owner explicitly granted bankFeed.
    function canReadBankFeed(companyId) {
      return isCompanyOwner(companyId)
        || (canReadCompany(companyId) && memberAccessAllows(companyId, 'bankFeed'));
    }

    // Strict workflow-only members read finance-free order summaries from the
    // /workflowOrders subcollection and must use callables to write — they never
    // touch /siparisler directly.
    function usesWorkflowSafeView(companyId) {
      return isWorkflowOnlyMember(companyId);
    }

    // Combined "needs assigned-to-self filter on /siparisler reads".
    function requiresAssignedToSelfFilter(companyId) {
      return isAssignedOnlyCustomMember(companyId);
    }

    function canReadOrderDocument(data) {
      return data.companyId is string
        && canReadCompany(data.companyId)
        && (!requiresAssignedToSelfFilter(data.companyId) || data.assignedToUid == request.auth.uid);
    }

    // Mirrors trialHasExpired() in functions/index.js, including the 36-hour grace
    // window that keeps a workspace open while a late renewal webhook lands. The
    // server already drops a lapsed trial to the free plan, but these rules read
    // billingPlan straight off the document, so without this a Team trial that
    // ended a month ago still opened the Team-only collections. Only a workspace
    // whose status is 'trialing' is ever tested: a paying customer is 'active'.
    function trialLapsed(data) {
      return data.get('billingStatus', '') == 'trialing'
        && (
          (data.get('billingTrialEndsAt', null) is timestamp
            && request.time > data.billingTrialEndsAt + duration.value(36, 'h'))
          || (!(data.get('billingTrialEndsAt', null) is timestamp)
            && data.get('billingCurrentPeriodEnd', null) is timestamp
            && request.time > data.billingCurrentPeriodEnd + duration.value(36, 'h'))
        );
    }

    function hasTeamPlan(companyId) {
      return companyExists(companyId)
        && !trialLapsed(get(companyPath(companyId)).data)
        && get(companyPath(companyId)).data.billingPlan in [
          'team_monthly', 'team_yearly', 'teamMonthly', 'teamYearly'
        ];
    }

    function hasAdvancedFinancePlan(companyId) {
      return companyExists(companyId)
        && !trialLapsed(get(companyPath(companyId)).data)
        && get(companyPath(companyId)).data.billingPlan in [
          'pro_monthly', 'pro_yearly', 'team_monthly', 'team_yearly',
          'proMonthly', 'proYearly', 'teamMonthly', 'teamYearly'
        ];
    }

    function canReadMessages(companyId) {
      return isCompanyOwner(companyId)
        || (
          signedIn()
          && companyExists(companyId)
          && memberRole(companyId) in ['owner', 'admin', 'member', 'viewer', 'workflow', 'workflowOnly', 'workflow_only', 'workflow-only', 'Workflow Only']
          && !memberSuspended(companyId)
        );
    }

    function canWriteMessages(companyId) {
      return isCompanyOwner(companyId)
        || (
          signedIn()
          && companyExists(companyId)
          && memberRole(companyId) in ['owner', 'admin', 'member']
          && !memberSuspended(companyId)
        );
    }

    function protectedTeamWorkspaceFields() {
      return [
        'members',
        'memberRoles',
        'memberCustomRoles',
        'memberAccess',
        'memberUids',
        'removedMemberUids',
        'customRoles'
      ];
    }

    // ownerUid is what both the server (uidIsCompanyOwner) and these rules
    // (isCompanyOwner) treat as the real owner, and nothing pinned it: an owner
    // could write any uid there from a plain client write and hand out full
    // owner rights off the books. It may only ever be set to your own uid — the
    // apps' self-repair writes do exactly that, an off-book co-owner does not.
    function validOwnerUidUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid'])
        || request.resource.data.ownerUid == request.auth.uid;
    }

    function validTeamWorkspaceUpdate(companyId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedTeamWorkspaceFields())
        || hasTeamPlan(companyId);
    }

    function advancedFinanceFields() {
      return [
        'paymentFee',
        'deliveryCost',
        'taxType',
        'taxRate',
        'taxAmount',
        'financialRemainingValues',
        'financialExpenseValues'
      ];
    }

    function safeBasicFinanceCreateValues(data) {
      return (!data.keys().hasAny(['paymentFee']) || data.paymentFee == 0)
        && (!data.keys().hasAny(['deliveryCost']) || data.deliveryCost == 0)
        && (!data.keys().hasAny(['taxType']) || data.taxType == '')
        && (!data.keys().hasAny(['taxRate']) || data.taxRate == 0)
        && (!data.keys().hasAny(['taxAmount']) || data.taxAmount == 0)
        && !data.keys().hasAny(['financialRemainingValues', 'financialExpenseValues']);
    }

    // Dynamic advanced finance values currently live under customFields keys such as
    // financialExpense::<title> and financialRemaining::<title>. Firestore Rules cannot
    // safely validate arbitrary map-key prefixes, so basic plans must use the verified
    // backend callable whenever customFields are written.
    function safeBasicCustomFieldsCreate(data) {
      return !data.keys().hasAny(['customFields']);
    }

    function validBasicCustomFieldsUpdate(companyId) {
      return hasAdvancedFinancePlan(companyId)
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['customFields']);
    }

    function validOrderFinanceCreate(companyId) {
      return hasAdvancedFinancePlan(companyId)
        || (safeBasicFinanceCreateValues(request.resource.data)
          && safeBasicCustomFieldsCreate(request.resource.data));
    }

    // The `estimates` array on an order is a display index, not the record. The
    // record — line items, totals, who approved and when, the signature — lives
    // in siparisler/{id}/estimateRecords, which the catch-all at the bottom of
    // this file denies to every client.
    //
    // It is deliberately NOT locked here. The Apple apps replace the whole order
    // document on save (FirebaseManager.setData(from:), no merge), so any rule
    // forbidding a change to these keys rejects every Mac and iPhone save — the
    // model re-encodes the array, and Firestore counts an integer rewritten as a
    // double as a change. The guard cost real saves and protected only a cache.

    function validOrderFinanceUpdate(companyId) {
      return hasAdvancedFinancePlan(companyId)
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(advancedFinanceFields());
    }

    function protectedBillingFields() {
      return [
        // Who currently holds a seat. It decides how many people a workspace
        // runs on, so it is as much a billing field as the plan is: an owner who
        // could restore members from a client would run seven people on five
        // seats. Written only by enforceWorkspaceSeatLimit and
        // updateWorkspaceMemberSuspension.
        'suspendedMembers',
        'billingPlan',
        'billingPlanName',
        'billingPlanSource',
        'billingStatus',
        // The trial's end date decides the plan just as surely as the plan field
        // does — trialHasExpired() in functions/index.js reads billingTrialEndsAt
        // FIRST — so leaving it writable let an owner post a date in the year 3000
        // and keep a Team trial forever, free. billingTrialUsedAt is the
        // once-per-workspace stamp; clearing it re-armed the free fortnight on
        // every re-subscribe. All server-written; no client ever sets them.
        'billingTrialEndsAt',
        'billingTrialStartedAt',
        'billingTrialUsedAt',
        'billingProvider',
        'billingProviderRawStatus',
        'billingEffectivePlan',
        'billingEffectivePlanTier',
        'billingEffectiveStatus',
        'billingEffectiveProvider',
        'billingEffectiveSubscriptionId',
        'billingEntitlementUpdatedAt',
        'billingActivePlanSubscriptionCount',
        'billingActivePlanProviders',
        'billingHasMultipleActiveSubscriptions',
        'billingDuplicateSubscriptionDetectedAt',
        'billingEntitlementResolutionReason',
        'billingEntitlementTriggerEvent',
        'billingEntitlementResolvedAt',
        'billingLastEntitlementResyncRequestedAt',
        'billingLastEntitlementResyncRequestedBy',
        'billingLastEntitlementResyncProvider',
        'billingLastEntitlementResyncCompletedAt',
        'billingLastEntitlementResyncCompletedBy',
        'billingLastEntitlementResyncFoundSubscriptions',
        'billingLastEntitlementResyncRecognisedSubscriptions',
        'billingLastEntitlementResyncStaleRecordsDeactivated',
        'billingStorageLimitMB',
        'billingTeamMemberLimit',
        'billingTeamIncludedSeats',
        'billingTeamSelfServiceMax',
        'billingAdditionalTeamSeatQuantity',
        'billingAdditionalTeamSeatKey',
        'billingAdditionalTeamSeatStatus',
        'billingAdditionalTeamSeatSubscriptionId',
        'billingAdditionalTeamSeatCurrentPeriodEnd',
        'billingStorageAddonMB',
        'billingStorageAddonKey',
        'billingStorageAddonStatus',
        'billingStorageAddonSubscriptionId',
        'billingStorageAddonCurrentPeriodEnd',
        'billingCustomerId',
        'billingStripeCustomerId',
        'billingCustomerCreatedAt',
        'billingSubscriptionId',
        'billingSubscriptionItemKey',
        'billingInterval',
        'billingCurrentPeriodEnd',
        'billingPreviousPaidPlan',
        'billingPreviousSubscriptionItemKey',
        'billingPreviousInterval',
        'billingCheckoutSessionId',
        'billingCheckoutCompletedAt',
        'billingEnvironment',
        'billingExportAccessPreserved',
        'billingLastInvoiceId',
        'billingLastInvoicePaidAt',
        'billingPaymentFailedAt',
        'billingUpdatedAt',
        'billingUpdatedBy',
        'woocommerceWebhookToken',
        'woocommerceWebhookTokenCreatedAt',
        'shopifyWebhookToken',
        'shopifyWebhookTokenCreatedAt',
        'inboundWebhookToken',
        'inboundWebhookTokenCreatedAt'
      ];
    }

    function hasSafeFreeDemoBillingValues(data) {
      // The plan was renamed from "Free Demo" to "Free" and all three clients
      // now write the new name — against a rule that still demanded the old one,
      // which denied every client-side workspace create. Both names are allowed:
      // store builds shipped before the rename still write the old string.
      return data.billingPlan == 'demo'
        && data.billingPlanName in ['Free', 'Free Demo']
        && data.billingPlanSource in ['new_workspace_default', 'signup_free_demo']
        && data.billingStorageLimitMB == 50
        && data.billingTeamMemberLimit == 1
        && (!('billingStatus' in data) || data.billingStatus == 'free')
        && (!('billingProviderRawStatus' in data) || data.billingProviderRawStatus == 'free')
        && !data.keys().hasAny([
          'billingCustomerId',
          'billingStripeCustomerId',
          'billingSubscriptionId',
          'billingSubscriptionItemKey',
          'billingEffectivePlan',
          'billingEffectivePlanTier',
          'billingEffectiveStatus',
          'billingEffectiveProvider',
          'billingEffectiveSubscriptionId',
          'billingEntitlementUpdatedAt',
          'billingActivePlanSubscriptionCount',
          'billingActivePlanProviders',
          'billingHasMultipleActiveSubscriptions',
          'billingDuplicateSubscriptionDetectedAt',
          'billingEntitlementResolutionReason',
          'billingEntitlementTriggerEvent',
          'billingEntitlementResolvedAt',
          'billingLastEntitlementResyncRequestedAt',
          'billingLastEntitlementResyncRequestedBy',
          'billingLastEntitlementResyncProvider',
          'billingLastEntitlementResyncCompletedAt',
          'billingLastEntitlementResyncCompletedBy',
          'billingLastEntitlementResyncFoundSubscriptions',
          'billingLastEntitlementResyncRecognisedSubscriptions',
          'billingLastEntitlementResyncStaleRecordsDeactivated',
          'billingAdditionalTeamSeatQuantity',
          'billingStorageAddonMB'
        ]);
    }

    function validNewCompanyBillingState() {
      return !request.resource.data.keys().hasAny(protectedBillingFields())
        || hasSafeFreeDemoBillingValues(request.resource.data);
    }

    function validCompanyBillingUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedBillingFields())
        || (
          (!resource.data.keys().hasAny(['billingPlan']) || resource.data.billingPlan == 'demo')
          && hasSafeFreeDemoBillingValues(request.resource.data)
        );
    }

    function isOwnMessagePreferenceDoc(userId) {
      return signedIn() && userId == request.auth.uid;
    }

    function validMessagePreferenceWrite(companyId, userId) {
      return isOwnMessagePreferenceDoc(userId)
        && canReadCompany(companyId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.companyId == companyId;
    }

    function canAccessOwnPersonalNotes(companyId, userId) {
      return signedIn()
        && userId == request.auth.uid
        && canReadCompany(companyId);
    }

    function validPersonalNoteCreate(companyId, userId) {
      return canAccessOwnPersonalNotes(companyId, userId)
        && request.resource.data.ownerUserId == request.auth.uid;
    }

    function validPersonalNoteUpdate(companyId, userId) {
      return canAccessOwnPersonalNotes(companyId, userId)
        && request.resource.data.ownerUserId == resource.data.ownerUserId;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && userId == request.auth.uid;

      match /workspaceAccess/{companyId} {
        allow read: if signedIn() && userId == request.auth.uid;

        // The workspace OWNER writes these — Team Access on Mac and iPhone
        // manages a member's role through this document, in the same batch as
        // the company's members map.
        //
        // What is gone is the self-write. storage.rules counts this document as
        // proof of membership, so allowing `userId == request.auth.uid` let a
        // removed member — or anyone who knew a Company ID — re-admit
        // themselves to another workspace's files with one write.
        allow create, update, delete: if signedIn() && isCompanyOwner(companyId);
      }
    }

    match /workspaceJoinRequests/{requestId} {
      // Join requests are created and updated only by verified callable backend actions.
      // Signed-in requesters and the target workspace owner may still read their relevant request state.
      //
      // The requesterUid branch is guarded with `in` so a document that lacks the
      // field — or a list query that does not pin it — falls through to the owner
      // branch instead of erroring the whole rule ("Property requesterUid is
      // undefined"). The owner branch must not assume the company document id
      // equals the owner uid (legacy/seeded workspaces differ), so it resolves
      // ownership through isCompanyOwner; list queries pin targetCompanyId with
      // an equality filter, which keeps that check provable.
      allow read: if signedIn()
        && (
          ('requesterUid' in resource.data && resource.data.requesterUid == request.auth.uid)
          || ('targetCompanyId' in resource.data && isCompanyOwner(resource.data.targetCompanyId))
        );

      allow create, update, delete: if false;
    }

    match /companies/{companyId} {
      allow create: if signedIn()
        && companyId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && validNewCompanyBillingState();

      allow read: if canReadCompany(companyId);
      // Query form used by the workspace pickers (e.g. /connect/shopify):
      // memberUids array-contains own uid. Must stay resource-only — get()
      // based helpers like canReadCompany are not provable for list queries.
      allow list: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow update: if isCompanyOwner(companyId)
        && validCompanyBillingUpdate()
        && validOwnerUidUpdate()
        && validTeamWorkspaceUpdate(companyId);
      // Deleting the workspace document from a client would strand every
      // subcollection, Storage object and member; deleteMyAccount /
      // deleteWorkspaceData do it properly server-side.
      allow delete: if false;
    }

    match /companies/{companyId}/billing/{document=**} {
      allow read: if canReadCompany(companyId);
      allow write: if false;
    }

    // Verified provider subscriptions are server-owned billing records.
    // Only the owner may read them; clients must never create or change them.
    match /companies/{companyId}/subscriptions/{document=**} {
      allow read: if isCompanyOwner(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/messageUserPreferences/{userId} {
      allow read: if hasTeamPlan(companyId)
        && isOwnMessagePreferenceDoc(userId)
        && canReadMessages(companyId);
      allow create, update: if hasTeamPlan(companyId)
        && canReadMessages(companyId)
        && validMessagePreferenceWrite(companyId, userId);
      allow delete: if false;
    }

    match /companies/{companyId}/messageSettings/{document=**} {
      allow read: if hasTeamPlan(companyId) && canReadMessages(companyId);
      allow write: if hasTeamPlan(companyId) && canWriteMessages(companyId);
    }

    // Personal Notes are available to every workspace role, including View Only
    // and Workflow Only, but they remain private to the signed-in user's mirror.
    // Collaborative note mirrors are distributed and synchronised by verified
    // callable functions using Admin SDK permissions.
    match /companies/{companyId}/personal_notes/{userId}/notes/{noteId} {
      allow read: if canAccessOwnPersonalNotes(companyId, userId);
      allow create: if validPersonalNoteCreate(companyId, userId);
      allow update: if validPersonalNoteUpdate(companyId, userId);
      allow delete: if canAccessOwnPersonalNotes(companyId, userId);
    }

    match /companies/{companyId}/personal_note_collaboration_invites/{document=**} {
      // Invitations are created/read/responded to only through verified callables.
      allow read, write: if false;
    }

    match /companies/{companyId}/quickReplyContributions/{document=**} {
      // Contributions are filtered and written through verified callables.
      allow read, write: if false;
    }

    match /companies/{companyId}/quickReplyUserSettings/{document=**} {
      // Each user's On-Device and Offline Template settings are accessed
      // through role-validated callable functions only.
      allow read, write: if false;
    }

    // Bank feed (Open Banking) data is server-written and owner-only: the
    // connection docs and transaction feed never open to other roles.
    match /companies/{companyId}/bankConnections/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/bankTransactions/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }

    // Inventory. Readable by anyone who can read the workspace so a screen can
    // list stock without a round trip, but written only through the callables:
    // status transitions, cost splitting and the sequential item number are
    // decided on the server, and a direct write would sidestep all three.
    match /companies/{companyId}/inventoryItems/{document=**} {
      allow read: if canReadCompany(companyId);
      allow write: if false;
    }

    // Purchases and suppliers follow the same rule as inventory: readable so a
    // screen can list them, server-written because a purchase decides how the
    // shipping is split across its lines and when its stock becomes real.
    match /companies/{companyId}/purchases/{document=**} {
      allow read: if canReadCompany(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/suppliers/{document=**} {
      allow read: if canReadCompany(companyId);
      allow write: if false;
    }

    // The movement ledger and the counts that write to it. Readable so a
    // report can be drawn, server-written because a stock figure that moved
    // without a ledger line — or a line without the move — would both be lies.
    match /companies/{companyId}/inventoryMovements/{document=**} {
      allow read: if canReadCompany(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/stocktakes/{document=**} {
      allow read: if canReadCompany(companyId);
      allow write: if false;
    }

    // Provider consent tokens — server-only, never client-readable.
    match /companies/{companyId}/bankTokens/{document=**} {
      allow read, write: if false;
    }

    // Push tokens. A token is the address of one person's phone, and members
    // share a workspace, not each other's devices: under the wildcard any member
    // could read every colleague's token or delete it and silence their alerts.
    //
    // Nobody reads this collection from a client - the server sends the pushes
    // and reads with admin rights, which rules do not apply to - so reads are
    // closed outright. Writes are allowed only for the row carrying your own
    // uid, which is the field all four apps already write, so registering and
    // signing out keep working exactly as they did.
    // Support manager list. This one is a privilege list, not data: the server
    // reads supportManagerUids out of it to decide who may act on other people's
    // tickets (index.js workspaceSupportSettings). Left to the wildcard rule
    // below it was writable by every member of the workspace, so any member
    // could append their own uid and grant themselves the power the owner/admin
    // check was there to withhold. No client reads or writes it; the server
    // reaches it through the Admin SDK, which does not consult these rules.
    match /companies/{companyId}/supportSettings/{document=**} {
      allow read, write: if false;
    }

    // Support tickets. The server stamps some of these targetRole:"owner_admin"
    // (index.js:4741) precisely because they are not for everyone. No client
    // reads them directly — the ticket screens go through callables — so the
    // targeting is enforced here rather than hoped for in the UI.
    match /companies/{companyId}/workspaceTickets/{document=**} {
      allow read, write: if false;
    }

    // The marker that says a WooCommerce payment has already been merged. A
    // member who could write it could make a real payment look already-merged,
    // or clear it and have one counted twice. Server-only bookkeeping.
    match /companies/{companyId}/wooMergedPayments/{document=**} {
      allow read, write: if false;
    }

    // A server-side count of workspace members. Nothing on any client reads it.
    match /companies/{companyId}/users/{document=**} {
      allow read, write: if false;
    }

    // Workspace activity notifications. Every client reads these (the bell), so
    // read stays open to the workspace — but no client writes them. Marking one
    // read goes through markActivityNotificationRead on all three platforms;
    // the direct-write branch in FirebaseManager.swift is behind
    // #if canImport(FirebaseFunctions) and never ships. Leaving write open let
    // any member forge or silently edit another person's notification.
    match /companies/{companyId}/notifications/{document=**} {
      allow read: if canReadCompany(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/deviceTokens/{tokenId} {
      allow read: if false;
      allow create: if signedIn()
        && canReadCompany(companyId)
        && request.resource.data.userId == request.auth.uid;
      // Update has to ask TWO questions, and the first one is the one that
      // matters: a merge write carries the merged result, so checking only what
      // is being written let a member set userId to their own and take over a
      // colleague's row. Own it first, and still own it afterwards.
      allow update: if signedIn()
        && canReadCompany(companyId)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && canReadCompany(companyId)
        && resource.data.userId == request.auth.uid;
    }

    // The connection trail. Every sibling bank collection was already excluded
    // from the wildcard above; this one was missed, which left an audit log any
    // member could rewrite. Android reads it in the Banking screen, so it stays
    // readable to whoever can read the feed - and writable to nobody.
    match /companies/{companyId}/bankAuditLog/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }

    // Stock locations and build recipes: same rule as the rest of inventory,
    // server-written so a recipe cannot quietly change what a build consumes.
    match /companies/{companyId}/inventoryLocations/{document=**} {
      allow read: if canReadCompany(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/inventoryRecipes/{document=**} {
      allow read: if canReadCompany(companyId);
      allow write: if false;
    }

    // Vendor grouping / manual "this repeats" marks — owner-readable, server-written.
    match /companies/{companyId}/bankVendors/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }

    // Workspace-defined bank categories (name, type, default VAT, connector
    // mappings) — owner-readable, written only through the callables.
    match /companies/{companyId}/bankCategories/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }

    // Accounting-connector idempotency ledger — server-only.
    match /companies/{companyId}/pandleSyncRuns/{document=**} {
      allow read, write: if false;
    }

    // Receipts waiting for their bank transaction — owner-readable, server-written.
    match /companies/{companyId}/bankReceiptInbox/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }

    // Categorisation rules — owner-readable, written only via callables.
    match /companies/{companyId}/bankRules/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }

    // Pandle bookkeeping bridge — connection/meta/mapping is owner-readable,
    // OAuth tokens are server-only.
    match /companies/{companyId}/pandleConnection/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/pandleTokens/{document=**} {
      allow read, write: if false;
    }

    // Accounting connector (QuickBooks Online and the providers after it).
    // Connections, identities, catalogue, mappings, events, postings, the
    // Needs Attention queue and the audit trail are readable with bank access
    // and written only through the callables; tokens, the webhook inbox and
    // the reconciliation cursors never leave the server.
    match /companies/{companyId}/accountingConnections/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }
    match /companies/{companyId}/accountingIdentities/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }
    match /companies/{companyId}/accountingCatalog/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }
    match /companies/{companyId}/accountingMappings/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }
    match /companies/{companyId}/accountingEvents/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }
    match /companies/{companyId}/accountingPostings/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }
    match /companies/{companyId}/accountingAttention/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }
    match /companies/{companyId}/accountingAudit/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }
    match /companies/{companyId}/accountingTokens/{document=**} {
      allow read, write: if false;
    }
    match /companies/{companyId}/accountingInbox/{document=**} {
      allow read, write: if false;
    }
    match /companies/{companyId}/accountingCursors/{document=**} {
      allow read, write: if false;
    }

    match /companies/{companyId}/orderDeletionRequests/{document=**} {
      // Workflow deletion approval is validated by callable functions only.
      allow read, write: if false;
    }

    match /companies/{companyId}/personalInterfaceSettings/{userId} {
      // Per-user appearance, language and finance-free PDF preferences.
      // READ: allow the signed-in user to live-subscribe to their OWN doc so
      // theme/language changes made on another device (Mac, iPhone, Android, Web)
      // sync instantly via Firestore snapshot listeners. Other members of the
      // workspace cannot read each other's personal preferences.
      // WRITE: still routed through the `savePersonalInterfaceSettings` callable
      // so the Cloud Function validates role + workspace membership server-side.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    function canReadMessageThread(companyId, threadId) {
      return hasTeamPlan(companyId)
        && canReadMessages(companyId)
        && (
          threadId == 'team'
          || isCompanyOwner(companyId)
          || (
            exists(/databases/$(database)/documents/companies/$(companyId)/messageThreads/$(threadId))
            && get(/databases/$(database)/documents/companies/$(companyId)/messageThreads/$(threadId)).data.memberUids is list
            && request.auth.uid in get(/databases/$(database)/documents/companies/$(companyId)/messageThreads/$(threadId)).data.memberUids
          )
        );
    }

    match /companies/{companyId}/messageThreads/{threadId} {
      allow read: if hasTeamPlan(companyId)
        && canReadMessages(companyId)
        && (
          isCompanyOwner(companyId)
          || (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
        );
      // Message writes are server-owned through callable functions, which validate
      // thread participants and role-specific actions.
      allow write: if false;

      match /{messagePath=**} {
        allow read: if canReadMessageThread(companyId, threadId);
        allow write: if false;
      }
    }

    match /companies/{companyId}/workflowOrders/{orderId} {
      // Finance-free order summary view used only by strict workflow-only members.
      // Custom-role assigned-only members read the full /siparisler doc directly.
      allow read: if usesWorkflowSafeView(companyId)
        && resource.data.assignedToUid == request.auth.uid;
      allow write: if false;
    }

    match /companies/{companyId}/{collectionId}/{document=**} {
      allow read: if collectionId != 'messageUserPreferences'
        && collectionId != 'messageSettings'
        && collectionId != 'messageThreads'
        && collectionId != 'billing'
        && collectionId != 'subscriptions'
        && collectionId != 'workflowOrders'
        && collectionId != 'personal_notes'
        && collectionId != 'personal_note_collaboration_invites'
        && collectionId != 'quickReplyContributions'
        && collectionId != 'quickReplyUserSettings'
        && collectionId != 'orderDeletionRequests'
        && collectionId != 'personalInterfaceSettings'
        && collectionId != 'bankConnections'
        && collectionId != 'bankTransactions'
        && collectionId != 'bankTokens'
        && collectionId != 'bankRules'
        && collectionId != 'bankReceiptInbox'
        && collectionId != 'bankVendors'
        && collectionId != 'pandleConnection'
        && collectionId != 'pandleTokens'
        && collectionId != 'pandleSyncRuns'
        && collectionId != 'accountingConnections'
        && collectionId != 'accountingTokens'
        && collectionId != 'accountingIdentities'
        && collectionId != 'accountingCatalog'
        && collectionId != 'accountingMappings'
        && collectionId != 'accountingEvents'
        && collectionId != 'accountingPostings'
        && collectionId != 'accountingInbox'
        && collectionId != 'accountingAttention'
        && collectionId != 'accountingCursors'
        && collectionId != 'accountingAudit'
        && collectionId != 'bankCategories'
        && collectionId != 'inventoryItems'
        && collectionId != 'purchases'
        && collectionId != 'suppliers'
        && collectionId != 'inventoryMovements'
        && collectionId != 'stocktakes'
        && collectionId != 'integrationSecrets'
        && collectionId != 'financeBulkRuns'
        && collectionId != 'fileRecords'
        && collectionId != 'customerMergeLog'
        && collectionId != 'settingsAuditLog'
        && collectionId != 'heldIntegrationOrders'
        && collectionId != 'bankAuditLog'
        && collectionId != 'deviceTokens'
        && collectionId != 'inventoryLocations'
        && collectionId != 'inventoryRecipes'
        && collectionId != 'notifications'
        && collectionId != 'users'
        && collectionId != 'wooMergedPayments'
        && collectionId != 'workspaceTickets'
        && collectionId != 'supportSettings'
        && collectionId != 'paypalPayouts'
        && collectionId != 'squarePayouts'
        && collectionId != 'trackingResults'
        && canReadCompany(companyId);
      allow write: if collectionId != 'messageUserPreferences'
        && collectionId != 'messageSettings'
        && collectionId != 'messageThreads'
        && collectionId != 'billing'
        && collectionId != 'subscriptions'
        && collectionId != 'workflowOrders'
        && collectionId != 'personal_notes'
        && collectionId != 'personal_note_collaboration_invites'
        && collectionId != 'quickReplyContributions'
        && collectionId != 'quickReplyUserSettings'
        && collectionId != 'orderDeletionRequests'
        && collectionId != 'personalInterfaceSettings'
        && collectionId != 'bankConnections'
        && collectionId != 'bankTransactions'
        && collectionId != 'bankTokens'
        && collectionId != 'bankRules'
        && collectionId != 'bankReceiptInbox'
        && collectionId != 'bankVendors'
        && collectionId != 'pandleConnection'
        && collectionId != 'pandleTokens'
        && collectionId != 'pandleSyncRuns'
        && collectionId != 'accountingConnections'
        && collectionId != 'accountingTokens'
        && collectionId != 'accountingIdentities'
        && collectionId != 'accountingCatalog'
        && collectionId != 'accountingMappings'
        && collectionId != 'accountingEvents'
        && collectionId != 'accountingPostings'
        && collectionId != 'accountingInbox'
        && collectionId != 'accountingAttention'
        && collectionId != 'accountingCursors'
        && collectionId != 'accountingAudit'
        && collectionId != 'bankCategories'
        && collectionId != 'inventoryItems'
        && collectionId != 'purchases'
        && collectionId != 'suppliers'
        && collectionId != 'inventoryMovements'
        && collectionId != 'stocktakes'
        && collectionId != 'integrationSecrets'
        && collectionId != 'financeBulkRuns'
        && collectionId != 'fileRecords'
        && collectionId != 'customerMergeLog'
        && collectionId != 'settingsAuditLog'
        && collectionId != 'heldIntegrationOrders'
        && collectionId != 'bankAuditLog'
        && collectionId != 'deviceTokens'
        && collectionId != 'inventoryLocations'
        && collectionId != 'inventoryRecipes'
        && collectionId != 'notifications'
        && collectionId != 'users'
        && collectionId != 'wooMergedPayments'
        && collectionId != 'workspaceTickets'
        && collectionId != 'supportSettings'
        && collectionId != 'paypalPayouts'
        && collectionId != 'squarePayouts'
        && collectionId != 'trackingResults'
        && canWriteCompanyData(companyId);
    }

    // Processor payouts are money: readable with the bank feed, written only by
    // the sync jobs. Tracking results are written by the courier refresh job;
    // clients only listen to them.
    match /companies/{companyId}/paypalPayouts/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/squarePayouts/{document=**} {
      allow read: if canReadBankFeed(companyId);
      allow write: if false;
    }

    match /companies/{companyId}/trackingResults/{document=**} {
      allow read: if canReadCompany(companyId);
      allow write: if false;
    }

    match /siparisler/{orderId} {
      // Workflow Only order creation and updates must use verified callables so
      // assignment cannot be removed or redirected client-side. Custom roles with
      // "Assigned Projects Only" CAN write directly here, as long as the order's
      // assignedToUid stays equal to their own uid (they cannot reassign).
      allow create: if signedIn()
        && request.resource.data.companyId is string
        && canWriteCompanyData(request.resource.data.companyId)
        && !usesWorkflowSafeView(request.resource.data.companyId)
        && (
          !isAssignedOnlyCustomMember(request.resource.data.companyId)
          || request.resource.data.assignedToUid == request.auth.uid
        )
        && validOrderFinanceCreate(request.resource.data.companyId);

      // Workflow Only reads finance-free assigned views under the workspace,
      // never the full order document that also contains financial fields.
      // Assigned-only custom-role members get the full document IF the order
      // is assigned to them.
      allow read: if canReadOrderDocument(resource.data)
        && !usesWorkflowSafeView(resource.data.companyId);

      allow update: if resource.data.companyId is string
        && request.resource.data.companyId == resource.data.companyId
        && canWriteCompanyData(resource.data.companyId)
        && !usesWorkflowSafeView(resource.data.companyId)
        && (
          !isAssignedOnlyCustomMember(resource.data.companyId)
          || (
            resource.data.assignedToUid == request.auth.uid
            && request.resource.data.assignedToUid == request.auth.uid
          )
        )
        && validOrderFinanceUpdate(resource.data.companyId)
        && validBasicCustomFieldsUpdate(resource.data.companyId);

      allow delete: if resource.data.companyId is string
        && canWriteCompanyData(resource.data.companyId)
        && !usesWorkflowSafeView(resource.data.companyId)
        && (
          !isAssignedOnlyCustomMember(resource.data.companyId)
          || resource.data.assignedToUid == request.auth.uid
        );
    }

    match /musteriler/{customerId} {
      allow create: if signedIn()
        && request.resource.data.companyId is string
        && canWriteCompanyData(request.resource.data.companyId);

      allow read: if resource.data.companyId is string
        && canReadCompany(resource.data.companyId);

      allow update: if resource.data.companyId is string
        && request.resource.data.companyId == resource.data.companyId
        && canWriteCompanyData(resource.data.companyId);

      allow delete: if resource.data.companyId is string
        && canWriteCompanyData(resource.data.companyId);
    }

    match /companySettings/{companyId} {
      allow read: if canReadCompany(companyId);
      // API credentials and owner-controlled Knowledge Base fields must be
      // changed only through saveQuickReplySettings callable validation.
      // The audit stamp is writable, but only as yourself — the change
      // history must not let one member sign another member's name.
      // Which keys this write touches (every key on create).
      function settingsKeysTouched() {
        return resource == null
          ? request.resource.data.keys()
          : request.resource.data.diff(resource.data).affectedKeys();
      }

      // Customer SMS costs money and is owner-only in saveWorkspaceSmsSettings;
      // a member could previously flip triggers or the sender straight from a
      // client write. Same for the tax/fee basis: saveFinancialSettings is
      // owner/admin, so the direct write is too.
      function ownerOnlySettingsKeys() {
        return ['smsTriggers', 'smsSenderId', 'smsSenderStatus', 'smsDefaultCallingCode'];
      }

      function financeSettingsKeys() {
        return ['seciliParaBirimi', 'seciliOndalik', 'feePercentage', 'defaultTaxRate',
          'taxRuleNameRevenue', 'taxRuleNameProfit', 'taxCalculationType', 'taxMilestoneEnabled',
          'taxMilestoneDate', 'corporationTaxEnabled', 'corporationTaxRate',
          // The Finance Engine's own three: whether the workspace is VAT
          // registered, whether its prices are quoted inclusive of VAT, and
          // which VAT method it uses. They decide what every order owes.
          'vatRegistered', 'pricesIncludeVat', 'vatMethod'];
      }

      // saveFinancialSettings asks for uidCanEditWorkspaceSettings plus the
      // financialInfo and settingsFinancial permissions — NOT for owner or
      // admin. A member the owner granted Financial Settings must be able to
      // save them, so this mirrors the callable rather than out-ranking it.
      function canWriteFinanceSettings(companyId) {
        return isCompanyOwner(companyId)
          || memberRole(companyId) in ['owner', 'admin']
          || (memberAccessAllows(companyId, 'settingsFinancial')
              && memberAccessAllows(companyId, 'financialInfo'));
      }

      allow write: if canWriteCompanyData(companyId)
        && !settingsKeysTouched().hasAny([
          'openAIKey', 'hasOpenAIKey', 'aiKnowledgeBase', 'replyMode',
          'customProductsJSON', 'customRulesJSON'
        ])
        && (!settingsKeysTouched().hasAny(['lastSettingsWriteByUid'])
          || request.resource.data.lastSettingsWriteByUid == request.auth.uid)
        && (isCompanyOwner(companyId) || !settingsKeysTouched().hasAny(ownerOnlySettingsKeys()))
        && (canWriteFinanceSettings(companyId) || !settingsKeysTouched().hasAny(financeSettingsKeys()));
    }

    match /quickReplySecrets/{companyId} {
      allow read, write: if false;
    }

    match /shopifyStores/{document=**} {
      // Shopify App Store integration: shop↔workspace links, settings and the
      // OAuth access tokens. Strictly server-side (Admin SDK); clients read
      // integration state only through verified callables.
      allow read, write: if false;
    }

    // The customer's link. Minted, read and retired by the Admin SDK only: the
    // document id is the hash of the token, so nothing here is guessable and
    // nothing client-side ever needs to see it.
    match /estimateLinks/{document=**} {
      allow read, write: if false;
    }

    // Customer portal token lookup. The document id is sha256 of the token and
    // no client ever reads it — getPortalForVisitor resolves it server-side, so
    // the collection stays unreachable even to a signed-in workspace member.
    match /portalLinks/{document=**} {
      allow read, write: if false;
    }

    match /shopifySessions/{document=**} {
      // Embedded-app session storage written by the app server only.
      allow read, write: if false;
    }

    // Etsy integration. Every one of these is written and read by Cloud
    // Functions only: the connections hold OAuth tokens (encrypted, but still
    // never a client's business), the OAuth states are single-use CSRF
    // defences, and the rest are the sync engine's own bookkeeping. A
    // workspace member reaches all of it through callables, which is what
    // lets us check their role first.
    match /etsyConnections/{document=**} {
      allow read, write: if false;
    }
    match /etsyOAuthStates/{document=**} {
      allow read, write: if false;
    }
    // WooCommerce connector: consumer keys and connect states are server-only.
    match /wooConnections/{document=**} {
      allow read, write: if false;
    }
    match /wooConnectStates/{document=**} {
      allow read, write: if false;
    }
    // Square connector: OAuth tokens and connect states are server-only.
    match /squareConnections/{document=**} {
      allow read, write: if false;
    }
    match /squareConnectStates/{document=**} {
      allow read, write: if false;
    }
    // Accounting connector: OAuth state pool and the realm → workspace map are server-only.
    match /accountingConnectStates/{document=**} {
      allow read, write: if false;
    }
    match /accountingRealms/{document=**} {
      allow read, write: if false;
    }
    // Common engine's review queue: read and resolved through callables only.
    match /commerceReviewQueue/{document=**} {
      allow read, write: if false;
    }
    match /etsyExternalOrders/{document=**} {
      allow read, write: if false;
    }
    match /etsyCustomerLinks/{document=**} {
      allow read, write: if false;
    }
    match /etsyWebhookEvents/{document=**} {
      allow read, write: if false;
    }
    // How many Etsy API calls the whole application has spent today. Server
    // bookkeeping: no client has any business reading or moving it, and a
    // client that could write it could make every shop stop syncing.
    match /etsyQuota/{document=**} {
      allow read, write: if false;
    }

    // Invitations are the token and nothing else. The document id IS the hash
    // of the link that was emailed, so a client that could list or read this
    // collection could not forge a token — but it could read every pending
    // invitation's address, role and workspace, and revoke or re-point one by
    // writing. The catch-all below already denies it; this says so on purpose,
    // so a future rule written for some other reason cannot widen it by
    // accident. Every read and write goes through the callables.
    match /workspaceInvitations/{invitationId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
