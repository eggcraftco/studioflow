rules_version = '2';
// The Amazon project's Firestore has no clients. Every read and write comes
// from a Cloud Run service through the Admin SDK, which bypasses these rules;
// anything that reaches this file is a client, and a client has no business
// here. Deny everything, everywhere, for everyone.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
