rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function companyExists(companyId) {
      return firestore.exists(/databases/(default)/documents/companies/$(companyId));
    }

    function companyData(companyId) {
      return firestore.get(/databases/(default)/documents/companies/$(companyId)).data;
    }

    function isOwner(companyId) {
      let data = companyData(companyId);
      return signedIn()
        && (request.auth.uid == companyId || request.auth.uid == data.ownerUid);
    }

    function membersMap(companyId) {
      let members = companyData(companyId).members;
      return members is map ? members : {};
    }

    function memberRolesMap(companyId) {
      let roles = companyData(companyId).memberRoles;
      return roles is map ? roles : {};
    }

    function workspaceAccessExists(companyId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/workspaceAccess/$(companyId));
    }

    function workspaceAccessData(companyId) {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)/workspaceAccess/$(companyId)).data;
    }

    function memberUidsList(companyId) {
      let uids = companyData(companyId).memberUids;
      return uids is list ? uids : [];
    }

    function memberEntry(companyId) {
      return membersMap(companyId)[request.auth.uid];
    }

    function memberRole(companyId) {
      let entry = memberEntry(companyId);
      return entry is map ? entry.role : "";
    }

    function memberRoleFallback(companyId) {
      return memberRolesMap(companyId)[request.auth.uid];
    }

    function workspaceAccessRole(companyId) {
      return workspaceAccessExists(companyId) ? workspaceAccessData(companyId).role : "";
    }

    function hasMemberRecord(companyId) {
      return request.auth.uid in membersMap(companyId)
        || request.auth.uid in memberRolesMap(companyId)
        || request.auth.uid in memberUidsList(companyId)
        || workspaceAccessExists(companyId);
    }

    function roleIs(role, allowed) {
      return role in allowed;
    }

    function canReadWorkspace(companyId) {
      return signedIn()
        && companyExists(companyId)
        && (isOwner(companyId) || hasMemberRecord(companyId));
    }

    function canEditWorkspaceFiles(companyId) {
      let editRoles = [
        "owner", "Owner",
        "admin", "Admin",
        "member", "Member",
        "workflow", "Workflow",
        "workflowOnly", "WorkflowOnly", "workflowonly",
        "workflow_only", "workflow-only",
        "Workflow Only", "Workflow only", "workflow only"
      ];
      return canReadWorkspace(companyId)
        && (
          isOwner(companyId)
          || roleIs(memberRole(companyId), editRoles)
          || roleIs(memberRoleFallback(companyId), editRoles)
          || roleIs(workspaceAccessRole(companyId), editRoles)
        );
    }

    function isWorkflowOnlyRole(companyId) {
      let workflowRoles = [
        "workflow", "Workflow",
        "workflowOnly", "WorkflowOnly", "workflowonly",
        "workflow_only", "workflow-only",
        "Workflow Only", "Workflow only", "workflow only"
      ];
      return roleIs(memberRole(companyId), workflowRoles)
        || roleIs(memberRoleFallback(companyId), workflowRoles)
        || roleIs(workspaceAccessRole(companyId), workflowRoles);
    }

    function workflowAssignedOrder(companyId, orderId) {
      return !isWorkflowOnlyRole(companyId)
        || (
          firestore.exists(/databases/(default)/documents/siparisler/$(orderId))
          && firestore.get(/databases/(default)/documents/siparisler/$(orderId)).data.companyId == companyId
          && firestore.get(/databases/(default)/documents/siparisler/$(orderId)).data.assignedToUid == request.auth.uid
        );
    }

    function canReadClientFiles(companyId, orderId) {
      let readRoles = [
        "owner", "Owner",
        "admin", "Admin",
        "member", "Member",
        "viewer", "Viewer",
        "viewOnly", "ViewOnly", "viewonly",
        "view_only", "view-only",
        "View Only", "View only", "view only",
        "workflow", "Workflow",
        "workflowOnly", "WorkflowOnly", "workflowonly",
        "workflow_only", "workflow-only",
        "Workflow Only", "Workflow only", "workflow only"
      ];
      return canReadWorkspace(companyId)
        && workflowAssignedOrder(companyId, orderId)
        && (
          isOwner(companyId)
          || roleIs(memberRole(companyId), readRoles)
          || roleIs(memberRoleFallback(companyId), readRoles)
          || roleIs(workspaceAccessRole(companyId), readRoles)
        );
    }

    function canWriteClientFiles(companyId, orderId) {
      let writeRoles = [
        "owner", "Owner",
        "admin", "Admin",
        "member", "Member",
        "workflow", "Workflow",
        "workflowOnly", "WorkflowOnly", "workflowonly",
        "workflow_only", "workflow-only",
        "Workflow Only", "Workflow only", "workflow only"
      ];
      return canReadWorkspace(companyId)
        && workflowAssignedOrder(companyId, orderId)
        && (
          isOwner(companyId)
          || roleIs(memberRole(companyId), writeRoles)
          || roleIs(memberRoleFallback(companyId), writeRoles)
          || roleIs(workspaceAccessRole(companyId), writeRoles)
        );
    }

    function messageThreadAccessible(companyId, threadId) {
      return threadId == "team"
        || isOwner(companyId)
        || (
          firestore.exists(/databases/(default)/documents/companies/$(companyId)/messageThreads/$(threadId))
          && firestore.get(/databases/(default)/documents/companies/$(companyId)/messageThreads/$(threadId)).data.memberUids is list
          && request.auth.uid in firestore.get(/databases/(default)/documents/companies/$(companyId)/messageThreads/$(threadId)).data.memberUids
        );
    }

    function canReadMessageFiles(companyId, threadId) {
      let readRoles = [
        "owner", "Owner", "admin", "Admin", "member", "Member",
        "viewer", "Viewer", "viewOnly", "ViewOnly", "viewonly", "view_only", "view-only", "View Only",
        "workflow", "Workflow", "workflowOnly", "WorkflowOnly", "workflowonly", "workflow_only", "workflow-only", "Workflow Only"
      ];
      return canReadWorkspace(companyId)
        && messageThreadAccessible(companyId, threadId)
        && (
          isOwner(companyId)
          || roleIs(memberRole(companyId), readRoles)
          || roleIs(memberRoleFallback(companyId), readRoles)
          || roleIs(workspaceAccessRole(companyId), readRoles)
        );
    }

    function canWriteMessageFiles(companyId, threadId) {
      let writeRoles = [
        "owner", "Owner", "admin", "Admin", "member", "Member",
        "workflow", "Workflow", "workflowOnly", "WorkflowOnly", "workflowonly", "workflow_only", "workflow-only", "Workflow Only"
      ];
      return canReadWorkspace(companyId)
        && messageThreadAccessible(companyId, threadId)
        && (
          isOwner(companyId)
          || roleIs(memberRole(companyId), writeRoles)
          || roleIs(memberRoleFallback(companyId), writeRoles)
          || roleIs(workspaceAccessRole(companyId), writeRoles)
        );
    }

    function clientFilesPlanAllowed(companyId) {
      let rawPlan = companyData(companyId).billingPlan;
      let plan = rawPlan is string ? rawPlan : "free_demo";
      return plan in [
        "pro_monthly", "pro_yearly",
        "team_monthly", "team_yearly",
        "proMonthly", "proYearly",
        "teamMonthly", "teamYearly"
      ];
    }

    function messageFilesPlanAllowed(companyId) {
      let rawPlan = companyData(companyId).billingPlan;
      let plan = rawPlan is string ? rawPlan : "free_demo";
      return plan in [
        "team_monthly", "team_yearly",
        "teamMonthly", "teamYearly"
      ];
    }

    function safeUploadSize() {
      return request.resource != null && request.resource.size <= 210 * 1024 * 1024;
    }

    match /companies/{companyId}/client_files/{orderId}/{fileName} {
      allow read: if canReadClientFiles(companyId, orderId) && clientFilesPlanAllowed(companyId);
      allow create, update: if canWriteClientFiles(companyId, orderId)
        && clientFilesPlanAllowed(companyId)
        && safeUploadSize();
      allow delete: if canWriteClientFiles(companyId, orderId) && clientFilesPlanAllowed(companyId);
    }

    match /companies/{companyId}/design_images/{fileName} {
      allow read: if canReadWorkspace(companyId);
      allow create, update: if canEditWorkspaceFiles(companyId) && safeUploadSize();
      allow delete: if canEditWorkspaceFiles(companyId);
    }


    match /companies/{companyId}/message_files/{threadId}/{fileName} {
      allow read: if canReadMessageFiles(companyId, threadId) && messageFilesPlanAllowed(companyId);
      allow create, update: if canWriteMessageFiles(companyId, threadId)
        && messageFilesPlanAllowed(companyId)
        && safeUploadSize();
      allow delete: if canWriteMessageFiles(companyId, threadId) && messageFilesPlanAllowed(companyId);
    }

    match /companies/{companyId}/message_files/{threadId}/{subPath=**} {
      allow read: if canReadMessageFiles(companyId, threadId) && messageFilesPlanAllowed(companyId);
      allow create, update: if canWriteMessageFiles(companyId, threadId)
        && messageFilesPlanAllowed(companyId)
        && safeUploadSize();
      allow delete: if canWriteMessageFiles(companyId, threadId) && messageFilesPlanAllowed(companyId);
    }


    match /companies/{companyId}/support_files/{userId}/{fileName} {
      allow read: if canReadWorkspace(companyId);
      allow create, update: if canEditWorkspaceFiles(companyId) && safeUploadSize();
      allow delete: if canEditWorkspaceFiles(companyId);
    }

    match /companies/{companyId}/support_files/{userId}/{subPath=**} {
      allow read: if canReadWorkspace(companyId);
      allow create, update: if canEditWorkspaceFiles(companyId) && safeUploadSize();
      allow delete: if canEditWorkspaceFiles(companyId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
