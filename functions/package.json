{
  "name": "eggcraft-tracking-functions",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "archiver": "^7.0.1",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0",
    "geoip-lite": "^1.4.10",
    "googleapis": "^173.0.0",
    "nodemailer": "^9.1.1",
    "stripe": "^22.1.1"
  },
  "scripts": {
    "test": "for f in test/qa/*.test.js test/inventory/*.test.js; do node \"$f\" || exit 1; done",
    "test:vectors": "node test/fixtures/generate-ebay-callback-vectors.mjs",
    "test:rules": "for f in test/qa/*.test.mjs; do node \"$f\" || exit 1; done",
    "test:e2e": "test/run-e2e.sh",
    "test:integration": "test/run-integration.sh",
    "test:all": "npm test && npm run test:rules && npm run test:e2e && npm run test:integration",
    "test:ci": "npm test && npm run test:rules && npm run test:e2e",
    "test:storage-rules": "firebase emulators:exec --only firestore,storage --project eggcraft-studio \"node test/qa/storage-scan-rules.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0"
  }
}
