# StudioFlow Stripe web billing scaffold
# Keep STRIPE_BILLING_ENABLED=false until Stripe test products/prices and webhooks are configured.
STRIPE_BILLING_ENABLED=false
STRIPE_ALLOW_LIVE_BILLING=false
STUDIOFLOW_WEB_APP_URL=http://localhost:3000

# Firebase Functions secrets, set with:
# firebase functions:secrets:set STRIPE_SECRET_KEY
# firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# Do not commit real secret values.
STRIPE_SECRET_KEY=sk_test_replace_me_for_local_only
STRIPE_WEBHOOK_SECRET=whsec_replace_me_for_local_only

# Stripe test Price IDs. Do not use live prices for this scaffold.
STRIPE_PRICE_LIFETIME_LITE=price_test_lifetime_lite
STRIPE_PRICE_PRO_MONTHLY=price_test_pro_monthly
STRIPE_PRICE_TEAM_MONTHLY=price_test_team_monthly
STRIPE_PRICE_ADDON_100GB=price_test_addon_100gb
STRIPE_PRICE_ADDON_200GB=price_test_addon_200gb
