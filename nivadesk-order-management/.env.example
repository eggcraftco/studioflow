# Shopify app credentials — injected automatically by `shopify app dev`;
# set manually on Cloud Run (values from `shopify app env show`).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_orders,read_customers,read_products,read_fulfillments

# NivaDesk backend bridge (Firebase Functions).
# NIVADESK_BRIDGE_SECRET must equal the SHOPIFY_BRIDGE_SECRET value in
# Secret Manager (mount it on Cloud Run; for local dev ask the owner).
NIVADESK_BRIDGE_SECRET=
NIVADESK_BRIDGE_URL=https://europe-west2-eggcraft-studio.cloudfunctions.net/shopifyAppBridge
NIVADESK_IMPORT_URL=https://europe-west2-eggcraft-studio.cloudfunctions.net/shopifyImportOrders

# Firestore (Application Default Credentials).
# Cloud Run: ambient. Local dev: `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=eggcraft-studio
