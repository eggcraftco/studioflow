# Temporary web deploy staging copy (~94 MB, has its own .git) — never commit
nivadesk-web-deploy-temp/

# Large demo media — keep out of git history (serve from CDN / use Git LFS)
studioflow-web/public/demo/*.mp4

# Photoshop masters are too large for git
store-metadata/screenshots/source/**/*.psd

# Large local demo recordings (not served by the site)
studioflow-web/public/NivaDesk_Demo_high.mov
studioflow-web/public/NivaDesk_Demo.mp4
