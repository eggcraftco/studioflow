<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Lets the app reach the local Firebase emulators over plain
  HTTP on the Android emulator's host alias, so a test workspace can be
  exercised without touching live data. Release builds never include this file,
  so production traffic stays HTTPS-only.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
