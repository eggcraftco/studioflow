NEXT_PUBLIC_FIREBASE_API_KEY=replace_me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=eggcraft-studio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=eggcraft-studio
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=eggcraft-studio.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_me
NEXT_PUBLIC_FIREBASE_APP_ID=replace_me

# Web push. Firebase Console -> Project settings -> Cloud Messaging ->
# Web configuration -> Web Push certificates -> Generate key pair, then paste
# the PUBLIC key here. Without it the browser never registers for push and the
# console repeats "VAPID key is not configured". NEXT_PUBLIC_* is inlined at
# build time, so it must be present in the environment that runs `next build`.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=replace_me

# Stripe billing scaffold (safe placeholders; do not put secret keys in frontend env)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me_optional

# Enable on staging/test deployments to discourage indexing.
NEXT_PUBLIC_STAGING_NO_INDEX=false
